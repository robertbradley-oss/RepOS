# RepOS local/demo runtime settings.
# The server does not auto-load this file; set these in your shell or deployment environment.

# Local default: 127.0.0.1. Use 0.0.0.0 only when a Node hosting platform requires it.
HOST=127.0.0.1
PORT=4173

# Default JSON persistence and upload locations. Keep these out of Git.
TESSARIO_DATA_FILE=.data/tessario-state.json
TESSARIO_UPLOAD_DIR=.uploads
TESSARIO_MAX_UPLOAD_BYTES=20971520

# Development auto-authenticates the seeded admin user. Production defaults to strict when unset.
TESSARIO_AUTH_MODE=development
TESSARIO_DISABLE_DEV_LOGIN=0
TESSARIO_SESSION_DAYS=7
# Required for production strict mode. Use a long random value, not this placeholder.
# REPOS_SESSION_SECRET=replace-with-at-least-32-random-characters

# Public demo example. This disables automatic admin fallback but keeps explicit demo sign-in available.
# TESSARIO_AUTH_MODE=demo
# TESSARIO_DISABLE_DEV_LOGIN=0
# TESSARIO_SESSION_DAYS=7
# REPOS_DEMO_PASSWORD=replace-with-a-private-demo-password

# Locked-down production example. This disables automatic admin fallback and dev login.
# Configure a real initial admin without committing secrets.
# NODE_ENV=production
# TESSARIO_AUTH_MODE=strict
# TESSARIO_DISABLE_DEV_LOGIN=1
# TESSARIO_SESSION_DAYS=7
# REPOS_SECURE_COOKIES=1
# REPOS_SESSION_SECRET=replace-with-at-least-32-random-characters
# REPOS_ADMIN_EMAIL=admin@example.com
# REPOS_ADMIN_NAME=RepOS Admin
# REPOS_ADMIN_ROLE=admin
# REPOS_ADMIN_PASSWORD=replace-with-a-long-private-password
# Prefer REPOS_ADMIN_PASSWORD_HASH when you can provision an scrypt hash out of band.
# REPOS_ADMIN_PASSWORD_HASH=scrypt$saltHex$hashHex

# Railway JSON mode example. Mount a volume at /data before using these paths.
# TESSARIO_DATA_FILE=/data/tessario-state.json
# TESSARIO_UPLOAD_DIR=/data/uploads

# Optional Enterprise SSO. Disabled unless REPOS_SSO_ENABLED=true.
# REPOS_SSO_ENABLED=false
# REPOS_SSO_ISSUER=https://your-identity-provider.example.com
# REPOS_SSO_CLIENT_ID=your-client-id
# REPOS_SSO_CLIENT_SECRET=your-client-secret
# REPOS_SSO_REDIRECT_URI=https://your-repos-domain.com/api/auth/sso/callback
# REPOS_SSO_SCOPES=openid email profile
# REPOS_SSO_ALLOWED_DOMAINS=company.com,ispringfilter.com

# Optional Postgres mode. Leave unset to use JSON-file persistence.
# DATABASE_URL=postgres://user:password@localhost:5432/tessario
# PGSSLMODE=require
# TESSARIO_AUTO_MIGRATE=1
